FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libmagic1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/academic_translator/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY apps/academic_translator /app/apps/academic_translator

ENV PYTHONPATH=/app
EXPOSE 8502

CMD ["streamlit", "run", "apps/academic_translator/app.py", "--server.port=8502", "--server.address=0.0.0.0"]
